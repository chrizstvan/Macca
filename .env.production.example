# ── Macca backend — production env (set these in Railway → Variables) ──
# Copy the real values in Railway's dashboard, NOT in this file.

# ── REQUIRED (app crashes on startup if missing) ───────────────────────
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public URL of THIS Railway service (used to register the Telegram webhook
# on startup). Set after the first deploy gives you the domain, then redeploy.
#   e.g. https://macca-production.up.railway.app
WEBHOOK_URL=

# ── WhatsApp Cloud API (production) ────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=          # System User token (permanent), NOT the 24h temp
WHATSAPP_VERIFY_TOKEN=          # must match the value pasted in Meta webhook config
WHATSAPP_APP_SECRET=            # Meta app secret → verifies X-Hub-Signature-256
WHATSAPP_TEMPLATE_LANG=id
WHATSAPP_WELCOME_TEMPLATE=onboard_volunteer

# ── Channel + behaviour ────────────────────────────────────────────────
ACTIVE_CHANNEL=whatsapp
ENVIRONMENT=production
TEST_MODE_ENABLED=false         # disables /test_as in prod
ALLOW_PEER_QUERY=false

# ── Fasilitator identity ───────────────────────────────────────────────
FASILITATOR_PHONE=
FASILITATOR_TELEGRAM_ID=

# ── Admin + webhook secrets (recommended in prod) ──────────────────────
ADMIN_TOKEN=                    # bearer for /admin/* endpoints (dashboard API_ADMIN_TOKEN)
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_FORM_SECRET=
# Dashboard origin(s) allowed for CORS (comma-separated).
CORS_ALLOW_ORIGINS=https://your-dashboard-host

# ── LLM tuning (optional — sensible defaults exist) ────────────────────
# CLAUDE_DEFAULT_MODEL=claude-haiku-4-5-20251001
# CLAUDE_COMPLEX_MODEL=claude-sonnet-4-6
# DEFAULT_MAX_TOKENS=1000
